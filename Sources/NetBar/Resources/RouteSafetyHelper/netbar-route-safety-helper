#!/bin/zsh
set -euo pipefail

NETWORKSETUP=/usr/sbin/networksetup
IFCONFIG=/sbin/ifconfig
PLUTIL=/usr/bin/plutil
ROUTE=/sbin/route
NETSTAT=/usr/sbin/netstat
AWK=/usr/bin/awk
GREP=/usr/bin/grep
SHASUM=/usr/bin/shasum
MKDIR=/bin/mkdir
CHMOD=/bin/chmod
SLEEP=/bin/sleep
RM=/bin/rm

STATE_DIR=/Library/Application\ Support/NetBar/RouteSafety
BACKUP_ORDER="$STATE_DIR/service-order-backup.txt"
BACKUP_DNS="$STATE_DIR/wifi-dns-backup.txt"
BACKUP_DNS_SHA="$STATE_DIR/wifi-dns-backup.sha256"
PENDING_KIND="$STATE_DIR/pending-kind.txt"
PENDING_TARGET="$STATE_DIR/pending-target.txt"
PROFILE=/Library/Application\ Support/NetBar/MacMiniLinkProfile.plist

fail() {
    print -u2 -- "$1"
    exit 1
}

[[ "$#" -eq 1 ]] || fail "usage: netbar-route-safety-helper status|prefer-wifi|prefer-mini|ensure-management-alias|repair-wifi-dns|commit|rollback"
case "$1" in
    status|prefer-wifi|prefer-mini|ensure-management-alias|repair-wifi-dns|commit|rollback) ACTION="$1" ;;
    *) fail "unsupported command" ;;
esac

service_rows() {
    "$NETWORKSETUP" -listnetworkserviceorder | "$AWK" '
        /^\([0-9]+\) / {
            name=$0
            sub(/^\([0-9]+\) /, "", name)
            sub(/^\*/, "", name)
        }
        /^\(Hardware Port:/ {
            port=$0
            device=$0
            sub(/^\(Hardware Port: /, "", port)
            sub(/, Device:.*$/, "", port)
            sub(/^.*Device: /, "", device)
            sub(/\)$/, "", device)
            print name "\t" port "\t" device
        }
    '
}

service_for_device() {
    service_rows | "$AWK" -F '\t' -v wanted="$1" '$3 == wanted && !found { print $1; found=1 }'
}

wifi_row() {
    service_rows | "$AWK" -F '\t' '(tolower($2) == "wi-fi" || tolower($2) == "wifi" || $2 == "无线局域网") && !found { print; found=1 }'
}

all_services() {
    service_rows | "$AWK" -F '\t' '{ print $1 }'
}

json_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    print -rn -- "$value"
}

WIFI_ROW="$(wifi_row)"
WIFI_SERVICE="$(print -r -- "$WIFI_ROW" | "$AWK" -F '\t' '{ print $1 }')"
WIFI_DEVICE="$(print -r -- "$WIFI_ROW" | "$AWK" -F '\t' '{ print $3 }')"
MINI_SERVICE="$(service_for_device bridge0)"
[[ -n "$WIFI_SERVICE" && -n "$WIFI_DEVICE" && -n "$MINI_SERVICE" ]] || fail "Wi-Fi or bridge0 service not found"

current_order() {
    all_services
}

mode_from_order() {
    local wifi_index mini_index index=0 name
    while IFS= read -r name; do
        (( index += 1 ))
        [[ "$name" == "$WIFI_SERVICE" ]] && wifi_index=$index
        [[ "$name" == "$MINI_SERVICE" ]] && mini_index=$index
    done < <(current_order)
    [[ -n "${wifi_index:-}" && -n "${mini_index:-}" ]] || fail "required service missing from order"
    if (( mini_index < wifi_index )); then
        print -r -- "mini"
    else
        print -r -- "wifi"
    fi
}

emit_status() {
    local mode pending=false pending_target='' pending_kind='' dns_mode dns_mini_dependent=false dns_output
    local management_address management_ready=false bridge_dhcp=false
    mode="$(mode_from_order)"
    if [[ -r "$PENDING_KIND" ]]; then
        pending=true
        pending_kind="$(<"$PENDING_KIND")"
        [[ -r "$PENDING_TARGET" ]] && pending_target="$(<"$PENDING_TARGET")"
    fi
    dns_output="$(wifi_dns_output)"
    dns_mode=manual
    "$GREP" -q "There aren't any DNS Servers" <<< "$dns_output" && dns_mode=automatic
    "$GREP" -qx '192.168.2.1' <<< "$dns_output" && dns_mini_dependent=true
    management_address="$($PLUTIL -extract managementLocalAddress raw -o - "$PROFILE" 2>/dev/null || true)"
    [[ -n "$management_address" ]] && "$IFCONFIG" bridge0 | "$GREP" -q "inet $management_address " && management_ready=true
    "$NETWORKSETUP" -getinfo "$MINI_SERVICE" | "$GREP" -q '^DHCP Configuration' && bridge_dhcp=true
    print -r -- "{\"protocolVersion\":4,\"mode\":\"$mode\",\"wifiService\":\"$(json_escape "$WIFI_SERVICE")\",\"wifiDevice\":\"$(json_escape "$WIFI_DEVICE")\",\"miniService\":\"$(json_escape "$MINI_SERVICE")\",\"pendingTransaction\":$pending,\"pendingKind\":\"$(json_escape "$pending_kind")\",\"pendingTarget\":\"$(json_escape "$pending_target")\",\"wifiDNSMode\":\"$dns_mode\",\"wifiDNSMiniDependent\":$dns_mini_dependent,\"managementAddressReady\":$management_ready,\"bridgeUsesDHCP\":$bridge_dhcp}"
}

ensure_management_alias() {
    [[ -r "$PROFILE" ]] || fail "management profile missing"
    local address mask conflicts route_conflicts
    address="$($PLUTIL -extract managementLocalAddress raw -o - "$PROFILE")"
    mask="$($PLUTIL -extract managementSubnetMask raw -o - "$PROFILE")"
    conflicts="$($IFCONFIG -a | "$AWK" -v address="$address" '
        /^[a-z0-9]+:/ { interface=$1; sub(/:$/, "", interface) }
        /inet 10\.254\.254\.[0-3] / { if (interface != "bridge0" || $2 != address) print interface ":" $2 }
    ')"
    [[ -z "$conflicts" ]] || fail "management subnet conflict"
    route_conflicts="$($NETSTAT -rn -f inet | "$AWK" '
        $1 == "10.254.254/30" || $1 == "10.254.254.0/30" || $1 == "10.254.254" {
            if ($NF != "bridge0") print $0
        }
    ')"
    [[ -z "$route_conflicts" ]] || fail "management subnet route conflict"
    "$IFCONFIG" bridge0 | "$GREP" -q "inet $address " || "$IFCONFIG" bridge0 alias "$address" netmask "$mask"
    "$IFCONFIG" bridge0 | "$GREP" -q "inet $address " || fail "management alias verification failed"
}

ensure_no_pending_transaction() {
    [[ ! -e "$PENDING_KIND" && ! -e "$BACKUP_ORDER" && ! -e "$BACKUP_DNS" && ! -e "$BACKUP_DNS_SHA" && ! -e "$PENDING_TARGET" ]] || fail "pending transaction requires commit or rollback"
}

save_route_backup() {
    ensure_no_pending_transaction
    "$MKDIR" -p "$STATE_DIR"
    "$CHMOD" 700 "$STATE_DIR"
    current_order > "$BACKUP_ORDER"
    print -r -- route > "$PENDING_KIND"
    "$CHMOD" 600 "$BACKUP_ORDER"
    "$CHMOD" 600 "$PENDING_KIND"
}

clear_transaction() {
    "$RM" -f "$BACKUP_ORDER" "$BACKUP_DNS" "$BACKUP_DNS_SHA" "$PENDING_KIND" "$PENDING_TARGET"
}

wifi_dns_output() {
    "$NETWORKSETUP" -getdnsservers "$WIFI_SERVICE"
}

wifi_dns_is_automatic() {
    local output
    output="$(wifi_dns_output)"
    "$GREP" -q "There aren't any DNS Servers" <<< "$output"
}

wifi_dns_depends_on_mini() {
    local output
    output="$(wifi_dns_output)"
    "$GREP" -qx '192.168.2.1' <<< "$output"
}

save_dns_backup() {
    ensure_no_pending_transaction
    "$MKDIR" -p "$STATE_DIR"
    "$CHMOD" 700 "$STATE_DIR"
    wifi_dns_output > "$BACKUP_DNS"
    "$SHASUM" -a 256 "$BACKUP_DNS" | "$AWK" '{ print $1 }' > "$BACKUP_DNS_SHA"
    print -r -- dns > "$PENDING_KIND"
    print -r -- automatic > "$PENDING_TARGET"
    "$CHMOD" 600 "$BACKUP_DNS" "$BACKUP_DNS_SHA" "$PENDING_KIND" "$PENDING_TARGET"
}

restore_dns() {
    [[ -r "$BACKUP_DNS" && -r "$BACKUP_DNS_SHA" ]] || fail "DNS backup missing"
    local expected actual
    expected="$(<"$BACKUP_DNS_SHA")"
    actual="$($SHASUM -a 256 "$BACKUP_DNS" | "$AWK" '{ print $1 }')"
    [[ "$actual" == "$expected" ]] || fail "DNS backup checksum mismatch"
    if "$GREP" -q "There aren't any DNS Servers" "$BACKUP_DNS"; then
        "$NETWORKSETUP" -setdnsservers "$WIFI_SERVICE" Empty
        wifi_dns_is_automatic || fail "DNS rollback verification failed"
    else
        local -a values restored
        values=("${(@f)$(<"$BACKUP_DNS")}")
        (( ${#values[@]} > 0 )) || fail "DNS backup empty"
        "$NETWORKSETUP" -setdnsservers "$WIFI_SERVICE" "${values[@]}"
        restored=("${(@f)$(wifi_dns_output)}")
        [[ "${(j:\n:)restored}" == "${(j:\n:)values}" ]] || fail "DNS rollback verification failed"
    fi
}

rollback_pending() {
    [[ -r "$PENDING_KIND" ]] || fail "pending transaction missing"
    local kind
    kind="$(<"$PENDING_KIND")"
    if [[ "$kind" == dns ]]; then
        restore_dns
        clear_transaction
        return 0
    fi
    [[ "$kind" == route && -r "$BACKUP_ORDER" ]] || fail "route backup missing"
    local -a original
    local expected wifi_index=0 mini_index=0 index=0 name
    original=("${(@f)$(<"$BACKUP_ORDER")}")
    for name in "${original[@]}"; do
        (( index += 1 ))
        [[ "$name" == "$WIFI_SERVICE" ]] && wifi_index=$index
        [[ "$name" == "$MINI_SERVICE" ]] && mini_index=$index
    done
    (( wifi_index > 0 && mini_index > 0 )) || fail "backup missing required services"
    expected=wifi
    (( mini_index < wifi_index )) && expected=mini
    "$NETWORKSETUP" -ordernetworkservices "${original[@]}"
    verify_route "$expected" || fail "manualRecoveryRequired"
    clear_transaction
}

apply_mode() {
    local target="$1" name
    local -a order
    order=("${(@f)$(current_order)}")
    local wifi_index=${order[(Ie)$WIFI_SERVICE]}
    local mini_index=${order[(Ie)$MINI_SERVICE]}
    (( wifi_index > 0 && mini_index > 0 )) || fail "required service missing from order"
    local should_swap=0
    if [[ "$target" == "mini" ]]; then
        if (( mini_index > wifi_index )); then should_swap=1; fi
    elif (( wifi_index > mini_index )); then
        should_swap=1
    fi
    if (( should_swap )); then
        local tmp="${order[$wifi_index]}"
        order[$wifi_index]="${order[$mini_index]}"
        order[$mini_index]="$tmp"
    fi
    "$NETWORKSETUP" -ordernetworkservices "${order[@]}"
    local attempt
    for attempt in {1..12}; do
        if [[ "$(mode_from_order)" == "$target" ]]; then
            return 0
        fi
        "$SLEEP" 1
    done
    fail "service order verification failed"
}

verify_route() {
    local target="$1" device="$WIFI_DEVICE"
    [[ "$target" == "mini" ]] && device=bridge0
    local attempt output interface
    for attempt in {1..12}; do
        output="$($ROUTE -n get default 2>/dev/null || true)"
        interface="$(print -r -- "$output" | "$AWK" '/interface:/ { print $2; exit }')"
        if [[ "$interface" == "$device" ]]; then
            return 0
        fi
        if [[ "$interface" == utun* ]] && "$ROUTE" -n get -ifscope "$device" default >/dev/null 2>&1; then
            return 0
        fi
        "$SLEEP" 1
    done
    return 1
}

case "$ACTION" in
    status)
        emit_status
        ;;
    ensure-management-alias)
        ensure_management_alias
        emit_status
        ;;
    prefer-wifi|prefer-mini)
        target=wifi
        [[ "$ACTION" == "prefer-mini" ]] && target=mini
        save_route_backup
        print -r -- "$target" > "$PENDING_TARGET"
        "$CHMOD" 600 "$PENDING_TARGET"
        if ! apply_mode "$target" || ! verify_route "$target"; then
            rollback_pending
            fail "route verification failed; original order restored"
        fi
        emit_status
        ;;
    repair-wifi-dns)
        [[ "$(mode_from_order)" == wifi ]] || fail "Wi-Fi must be the preferred physical service before DNS repair"
        wifi_dns_depends_on_mini || fail "Wi-Fi DNS does not depend on the fixed Mac mini address"
        save_dns_backup
        if ! "$NETWORKSETUP" -setdnsservers "$WIFI_SERVICE" Empty || ! wifi_dns_is_automatic; then
            restore_dns
            clear_transaction
            fail "DNS repair failed; original DNS restored"
        fi
        emit_status
        ;;
    commit)
        [[ -r "$PENDING_KIND" && -r "$PENDING_TARGET" ]] || fail "pending transaction missing"
        kind="$(<"$PENDING_KIND")"
        target="$(<"$PENDING_TARGET")"
        if [[ "$kind" == dns ]]; then
            [[ "$target" == automatic ]] || fail "invalid pending DNS target"
            wifi_dns_is_automatic || fail "pending DNS target no longer matches configuration"
        else
            [[ "$kind" == route && ( "$target" == "wifi" || "$target" == "mini" ) ]] || fail "invalid pending route target"
            [[ "$(mode_from_order)" == "$target" ]] || fail "pending target no longer matches service order"
            verify_route "$target" || fail "pending target route verification failed"
        fi
        clear_transaction
        emit_status
        ;;
    rollback)
        rollback_pending
        emit_status
        ;;
esac
